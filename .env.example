# Names only. Copy to .env and fill locally; never commit real values.
# Postgres (test container: npm run db:up -> port 54320)
DATABASE_URL=postgresql://sakhi:sakhi@localhost:54320/sakhiline_test?schema=public
TEST_DATABASE_URL=
# local = fixture sign-in allowed (demo/tests); live = fixture identity rejected
APP_MODE=local
FIXTURE_AUTH=
# >= 32 chars; signs session cookies and CSRF tokens
SESSION_SECRET=
CONTEXT_TTL_SECONDS=600
# mock | http
EXTRACTION_PROVIDER=mock
# Server-only Gnani speech key. Never expose to apps/web.
GNANI_API_KEY=
PORT=3000
