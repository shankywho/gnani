{
  "name": "sakhiline",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/contracts",
    "packages/db",
    "apps/api",
    "apps/web",
    "eval"
  ],
  "scripts": {
    "postinstall": "npm exec -w @sakhiline/db -- prisma generate",
    "db:up": "docker compose -f packages/db/docker-compose.test.yml up -d",
    "db:down": "docker compose -f packages/db/docker-compose.test.yml down",
    "db:migrate:test": "npm run db:migrate:test -w @sakhiline/db",
    "db:seed:test": "npm run db:seed:test -w @sakhiline/db",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:integration": "npm test -w @sakhiline/db && npm exec -w @sakhiline/api -- vitest run tests/integration",
    "test:security": "npm exec -w @sakhiline/api -- vitest run tests/security",
    "test:load:fixture": "npm exec -w @sakhiline/api -- vitest run tests/load",
    "eval:self-test": "npm run eval:self-test -w @sakhiline/eval",
    "dev:api": "DATABASE_URL=$npm_package_config_devdb npm run dev -w @sakhiline/api",
    "start:api": "npm start -w @sakhiline/api",
    "test:contract": "npm exec -w @sakhiline/api -- vitest run tests/contract",
    "dev:web": "npm run dev -w @sakhiline/web",
    "build": "npm run build -w @sakhiline/web",
    "db:dev:setup": "node scripts/db-create.mjs sakhiline_dev && DATABASE_URL=$npm_package_config_devdb npm run db:migrate:test && DATABASE_URL=$npm_package_config_devdb npm run db:seed:test",
    "test:e2e": "npm run db:dev:setup && playwright test",
    "eval:run": "DATABASE_URL=$npm_package_config_devdb npm run eval:run -w @sakhiline/eval --",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "config": {
    "devdb": "postgresql://sakhi:sakhi@localhost:54320/sakhiline_dev?schema=public"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "pg": "^8.23.1"
  }
}
